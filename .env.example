# --- Foundry / OSDK ---
# Copy this file to .env and fill in real values.
# Never commit .env to git.

FOUNDRY_URL=https://your-stack.palantirfoundry.com
FOUNDRY_TOKEN=eyJhbGciOi...replace-with-real-token...
FOUNDRY_OSDK_CLIENT_ID=
FOUNDRY_OSDK_CLIENT_SECRET=
FOUNDRY_ONTOLOGY_RID=ri.ontology.main.ontology.your-rid-here

# --- Hardware ---
# Override if your Pico W shows up at a different serial path.
# Find it with: ls /dev/cu.usbmodem*
PICO_SERIAL_PORT=/dev/cu.usbmodem101
PICO_BAUDRATE=115200

# --- Camera ---
# OpenCV camera index. 0 = built-in / default. Try 1, 2 for external USB cams.
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# --- Jetson (CASK) ---
# SSH details for the CASK appliance. Update once you have the kit.
JETSON_HOST=
JETSON_USER=
JETSON_SSH_KEY=~/.ssh/id_ed25519

# --- Engagement defaults ---
DEFAULT_SWEEP_RADIUS_DEG=3.0
DEFAULT_SWEEP_HZ=0.5
FIBER_SIGNAL_THRESHOLD=0.20
